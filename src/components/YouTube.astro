---
// Lightweight YouTube embed: shows the thumbnail and only loads the player on click.
// Also outputs VideoObject structured data for Google video results.
interface Props {
  id: string;
  title: string;
  description: string;
  uploadDate: string; // ISO date, e.g. 2026-11-10
  duration?: string; // ISO 8601, e.g. PT4M22S
}
const { id, title, description, uploadDate, duration } = Astro.props;
const thumb = `https://i.ytimg.com/vi/${id}/maxresdefault.jpg`;
const embed = `https://www.youtube-nocookie.com/embed/${id}`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: title,
  description,
  thumbnailUrl: [thumb],
  uploadDate,
  embedUrl: `https://www.youtube.com/embed/${id}`,
  ...(duration ? { duration } : {}),
  publisher: { '@type': 'Organization', name: 'Site Poster Pro', url: 'https://siteposterpro.com/' },
};
---

<div class="sp-video not-content" data-embed={embed} data-title={title}>
  <button type="button" class="sp-video__btn" aria-label={`Play video: ${title}`}>
    <img src={thumb} alt={title} loading="lazy" width="1280" height="720" />
    <span class="sp-video__play" aria-hidden="true">
      <svg viewBox="0 0 68 48" width="68" height="48"><path d="M66.5 7.7a8.5 8.5 0 0 0-6-6C55.2.3 34 .3 34 .3s-21.2 0-26.5 1.4a8.5 8.5 0 0 0-6 6C.1 13 .1 24 .1 24s0 11 1.4 16.3a8.5 8.5 0 0 0 6 6C12.8 47.7 34 47.7 34 47.7s21.2 0 26.5-1.4a8.5 8.5 0 0 0 6-6C67.9 35 67.9 24 67.9 24s0-11-1.4-16.3Z" fill="#e8343f"/><path d="M45 24 27 14v20" fill="#fff"/></svg>
    </span>
  </button>
</div>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<style>
  .sp-video { position: relative; aspect-ratio: 16 / 9; border-radius: 0.75rem; overflow: hidden;
    background: #0b1439; border: 1px solid var(--sl-color-gray-5); margin-block: 1.5rem; }
  .sp-video__btn { all: unset; cursor: pointer; display: block; width: 100%; height: 100%; position: relative; }
  .sp-video__btn img { width: 100%; height: 100%; object-fit: cover; display: block; border: 0; border-radius: 0; }
  .sp-video__play { position: absolute; inset: 0; display: grid; place-items: center; transition: transform .15s; }
  .sp-video__btn:hover .sp-video__play, .sp-video__btn:focus-visible .sp-video__play { transform: scale(1.1); }
  .sp-video__btn:focus-visible { outline: 3px solid var(--sl-color-accent); outline-offset: -3px; }
  .sp-video :global(iframe) { width: 100%; height: 100%; border: 0; display: block; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.sp-video').forEach((el) => {
    el.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `${el.dataset.embed}?autoplay=1&rel=0`;
      iframe.title = el.dataset.title || 'Video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      el.replaceChildren(iframe);
    }, { once: true });
  });
</script>
